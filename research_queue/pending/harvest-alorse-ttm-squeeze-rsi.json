      "creator": "John F. Carter",
      "claim": "Volatility compression (BB inside KC) tends to precede directional expansion."
    },
    {
      "type": "web",
      "role": "secondary",
      "title": "Alorse pinescript-strategies TTM squeeze + RSI",
      "creator": "Alorse",
      "claim": "Squeeze release with RSI direction filter."
    }
  ],
  "hypothesis": {
    "behavior": "Intraday volatility compression on MES releases into a directional move that persists long enough to beat costs.",
    "failure_theory": [
      "Squeeze releases may be mostly noise on 5m bars.",
      "Costs and next-bar fills may erase the edge.",
      "Breakout families (Keltner/Chesler, Donchian, NR7) already failed here."
