{
  "schema": "qf_candidate_v1",
  "candidate": {
    "title": "NVDA 5-minute opening range breakout on high opening-volume days",
    "one_line": "On days with heavy first-5-minute volume, trade the first 5-minute candle's direction when price breaks its extreme; flat 15:55. Source: Zarattini, Barbon and Aziz (2024), SSRN 4729284.",
    "family": "intraday_momentum",
    "status": "ready_for_review"
  },
  "sources": [
    {
      "type": "paper",
      "role": "primary",
      "title": "A Profitable Day Trading Strategy For The U.S. Equity Market",
      "creator": "Carlo Zarattini; Andrea Barbon; Andrew Aziz",
      "url": "https://papers.ssrn.com/sol3/papers.cfm?abstract_id=4729284",
      "claim": "5-minute ORB on Stocks in Play (high relative volume), 7,000+ stocks 2016-2023: top-20 portfolio 1,600% net, Sharpe 2.81."
    }
  ],
  "hypothesis": {
    "behavior": "Heavy early volume marks news-driven order imbalance, so the first candle's direction continues.",
    "failure_theory": [
      "Independent replication found net edge near zero after spread and slippage.",
      "Paper has no out-of-sample period and charges no slippage.",
      "Single stock lacks the paper's daily top-20 selection; our volume ratio uses the all-day 14-day minute average, not the same-time average."
    ]
  },
