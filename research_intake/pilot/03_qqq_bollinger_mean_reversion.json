      "High",
      "Low",
      "Close",
      "Volume"
    ],
    "minimum_resolution": "1m"
  },
  "rules": {
    "setup": [
      "QQQ regular session 09:30-16:00 ET on 1m bars; signals use completed bars and fill at the next bar open."
    ],
    "long_entry": [
      "Close crosses below the lower band, 09:50-15:30."
    ],
    "exits": {
      "rule": "Exit after N bars; 0.5% stop.",
      "time_exit": "Flat by 15:55 ET; no overnight position."
    },
    "max_trades_per_session": 4,
    "short_entry": [
      "Close crosses above the upper band."
    ]
  },
  "fixed": {
    "bar_interval": "1m",
    "session_reset": true,
    "flat_at": "15:55",
    "max_trades_per_session": 4,
    "entry_fill": "next_contiguous_bar_open"
  },
  "variables": {
    "std_mult": {
      "values": [
        2,
        2.5,
        3
      ],
      "rationale": "Band width in standard deviations."
    },
    "hold_bars": {
      "values": [
        15,
        30,
        60
      ],
      "rationale": "Time exit in 1m bars."
    }
  },
  "variants": [],
  "open_questions": [],
  "execution": {
    "use_qf_defaults": true,
    "special_assumptions": {
      "position_size": "one unit, no accumulation",
      "direction": "long and short"
    }
  },
  "evaluation": {
    "use_qf_standard_screen": true,
    "candidate_specific_checks": [
      "Evaluate only the predeclared grid; no expansion after seeing results."
