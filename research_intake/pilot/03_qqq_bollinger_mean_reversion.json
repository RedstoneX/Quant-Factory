  },
  "exclusions": [
    "No overnight position.",
    "No paper/live trading or automatic promotion.",
    "No filter beyond the rule_spec."
  ],
  "rule_spec": {
    "language": "qf_rules_v1",
    "bar": "1m",
    "tick_size": 0.01,
    "session": {
      "timezone": "America/New_York",
      "open": "09:30",
      "close": "16:00"
    },
    "flat_at": "15:55",
    "signals": [
      {
        "when": {
          "all": [
            {
              "crosses_below": [
                "close",
                {
                  "bollinger": "close",
                  "length": 20,
                  "std_mult": {
                    "param": "std_mult"
