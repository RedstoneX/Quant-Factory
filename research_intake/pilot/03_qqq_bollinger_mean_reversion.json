            },
            {
              "time_between": [
                "09:50",
                "15:30"
              ]
            }
          ]
        },
        "side": "long"
      },
      {
        "when": {
          "all": [
            {
              "crosses_above": [
                "close",
                {
                  "bollinger": "close",
                  "length": 20,
                  "std_mult": {
                    "param": "std_mult"
                  },
                  "output": "upper"
                }
              ]
            },
            {
              "time_between": [
                "09:50",
                "15:30"
              ]
            }
          ]
        },
        "side": "short"
      }
    ],
    "exit": {
