      "url": "https://en.wikipedia.org/wiki/Bollinger_Bands"
    }
  ],
  "hypothesis": {
    "behavior": "Closes outside a volatility band may snap back toward the mean within an hour.",
    "failure_theory": [
      "Band breaks may instead mark trend starts.",
      "Costs and next-bar fills may erase a published gross edge."
    ]
