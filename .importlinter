# import-linter contracts: the architecture boundaries from config/architecture.json
# expressed as standard forbidden/layers contracts. Run with `lint-imports`.
# Component vocabulary (same names as config/architecture.json):
#   licensed_engine      = backtesting.vectorbt_runtime
#   research_entrypoints = backtesting.run_*
#   backtesting (core)   = every other backtesting subpackage/module
#   dashboard_public     = the dashboard package module itself
#   dashboard_ui         = dashboard.ui
#   dashboard_models     = every other dashboard module
[importlinter]
root_packages =
    agent_gateway
    backtesting
    dashboard
    deployment
    execution
    market_data
    orchestration
    persistence
    prefect_spike
    research_intake
    rule_language
    strategies
    tools
include_external_packages = False
exclude_type_checking_imports = True

[importlinter:contract:top-layers]
name = Top-level layering (tools > deployment > entry surfaces > prefect > services)
type = layers
layers =
    tools
    deployment
    agent_gateway | dashboard | execution
    prefect_spike
    orchestration | research_intake

[importlinter:contract:foundation-layers]
name = Foundation layering (persistence/market_data > strategies > rule_language)
type = layers
layers =
    persistence | market_data
    strategies
    rule_language

[importlinter:contract:licensed-engine]
name = licensed_engine imports nothing from the project
type = forbidden
allow_indirect_imports = True
source_modules =
    backtesting.vectorbt_runtime
forbidden_modules =
    agent_gateway
    backtesting.execution_comparison
    backtesting.experiments
    backtesting.monte_carlo
    backtesting.out_of_sample
    backtesting.portability
    backtesting.robustness
    backtesting.screening
    backtesting.validation
    backtesting.walk_forward
    backtesting.run_mes_orb
    backtesting.run_mes_overnight_gap_reversal
    backtesting.run_mes_overnight_gap_reversal_durable
    backtesting.run_rsi_demo
    backtesting.run_rsi_robustness
    backtesting.run_spy_donchian
    backtesting.run_spy_donchian_low_frequency_walk_forward
    backtesting.run_spy_donchian_oos
    backtesting.run_spym_intraday_momentum
    backtesting.run_spym_intraday_momentum_durable
    dashboard
    deployment
    execution
    market_data
    orchestration
    persistence
    prefect_spike
    research_intake
    rule_language
    strategies
    tools

